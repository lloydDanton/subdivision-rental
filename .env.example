# ============================================================
# .env.example — SubdivisionStay Environment Variables
# ============================================================
# Copy this file to .env.local or .env and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.
#
#   cp .env.example .env
#
# ============================================================

# ------------------------------------------------------------
# FRONTEND API CONFIG (Vite)
# ------------------------------------------------------------
# Point to your running C++ Crow REST API server.
# When using Vite proxy, leaving this empty or setting http://localhost:8080 works seamlessly.
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------
# SUPABASE — Frontend (Optional direct connection)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------
# C++ BACKEND CONFIG (Server-side)
# ------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_HOST=localhost

# ------------------------------------------------------------
# SUPABASE — C++ Backend Database Access
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password-here
